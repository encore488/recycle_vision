out/

# Model weights fetched at runtime, into the working directory.
# Deliberately broad: ultralytics downloads whatever a script asks for
# (yolov8, yolo11, yoloe, sam, mobile_sam, mobileclip), and specific patterns
# kept letting new ones through.
*.pt
*.ts
!vocab/*.pt

